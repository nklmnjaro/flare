# Narrow augmentation for allure-python-commons/allure-pytest 2.16.0.
# Their published typing omits the decorator/dynamic APIs used below and leaves
# allure.attach as Any under mypy 1.19.1. The step overload is repeated because
# a partial module stub shadows that module. Delete this file once upstream
# strict typing covers exactly these public APIs, including attach.

from collections.abc import Callable
from contextlib import AbstractContextManager
from typing import overload

class Decorator:
    def __call__[**P, R](
        self,
        function: Callable[P, R],
    ) -> Callable[P, R]: ...

def title(test_title: str) -> Decorator: ...
def parent_suite(parent_suite_name: str) -> Decorator: ...
def suite(suite_name: str) -> Decorator: ...
def epic(*epics: str) -> Decorator: ...
def feature(*features: str) -> Decorator: ...
def tag(*tags: str) -> Decorator: ...
def link(
    url: str,
    link_type: str = ...,
    name: str | None = ...,
) -> Decorator: ...
def attach(
    body: str,
    name: str | None = ...,
    attachment_type: str | None = ...,
    extension: str | None = ...,
) -> None: ...

class Dynamic:
    @staticmethod
    def label(label_type: str, *labels: str) -> None: ...
    @staticmethod
    def story(*stories: str) -> None: ...
    @staticmethod
    def sub_suite(sub_suite_name: str) -> None: ...
    @staticmethod
    def tag(*tags: str) -> None: ...

@overload
def step(value: str) -> AbstractContextManager[None]: ...
@overload
def step[**P, R](value: Callable[P, R]) -> Callable[P, R]: ...
